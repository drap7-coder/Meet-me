# Server-only Google Maps Platform key.
GOOGLE_MAPS_API_KEY=your_google_maps_key

# Server-only TMDB credentials. Set either TMDB_API_KEY or TMDB_READ_ACCESS_TOKEN.
TMDB_API_KEY=your_tmdb_api_key
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token

# Server-only natural-language parser configuration.
NLP_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=30000
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Public app origin used for generated share links. This is safe to expose.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: show provider/API debug panel on watch & events results.
NEXT_PUBLIC_ENABLE_DEV_PANEL=false

# Required in production for share links and API rate limiting (Vercel KV or Upstash Redis REST)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional aliases supported by the code when using Upstash directly.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional server-only destination for feedback routing (not exposed to the client).
FEEDBACK_EMAIL=
